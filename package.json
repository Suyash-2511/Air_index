{
  "name": "saans",
  "version": "0.1.0",
  "private": true,
  "description": "Smog-season planner for families: estimates each person's inhaled PM2.5 dose and ranks daily changes by how much they actually cut it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@google/genai": "^3.5.0",
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.53.0",
    "postcss": "^8.5.32"
  }
}
